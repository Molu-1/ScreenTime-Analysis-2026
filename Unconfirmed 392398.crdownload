# 📥 Step 1: Upload your file
from google.colab import files
uploaded = files.upload()

import pandas as pd

# 📂 Step 2: Load dataset
# Replace with your actual filename after upload
df = pd.read_csv("daily_screen_tim.txt", sep="\t")   # agar tab-separated hai

# 👀 Step 3: Quick look
print(df.head())
print(df.info())

# 🔍 Step 4: Check duplicates
duplicates = df[df.duplicated(subset=['transaction_id'])]
print("Duplicate rows:\n", duplicates)

# Remove duplicates
df = df.drop_duplicates(subset=['transaction_id'])

# 🔍 Step 5: Check missing values
print("Missing values:\n", df.isnull().sum())

# 🧹 Step 6: Handle missing values
# Fill daily_screen_time with mean
df['daily_screen_time'].fillna(df['daily_screen_time'].mean(), inplace=True)

# Fill age with median
df['age'].fillna(df['age'].median(), inplace=True)

# Fill gender with mode
df['gender'].fillna(df['gender'].mode()[0], inplace=True)

# ✅ Step 7: Verify cleaned data
print("After cleaning:\n", df.isnull().sum())
print("Remaining duplicates:", df.duplicated(subset=['transaction_id']).sum())

# 💾 Step 8: Save cleaned file
df.to_csv("cleaned_screen_time.csv", index=False)

from google.colab import files
uploaded = files.upload()

import pandas as pd

# 📂 Step 2: Load dataset
# Replace with your actual filename after upload
df = pd.read_csv("/content/archive (8).zip")

print(df.head())
print(df.info())

# 🔍 Step 4: Check duplicates
duplicates = df[df.duplicated(subset=['transaction_id'])]
print("Duplicate rows:\n", duplicates)

# Remove duplicates
df = df.drop_duplicates(subset=['transaction_id'])

# 🔍 Step 5: Check missing values
print("Missing values:\n", df.isnull().sum())

# 🧹 Step 6: Handle missing values
# Fill daily_screen_time with mean
df['daily_screen_time_hours'].fillna(df['daily_screen_time_hours'].mean(), inplace=True)

# Fill age with median
df['age'].fillna(df['age'].median(), inplace=True)

# Fill gender with mode
df['gender'].fillna(df['gender'].mode()[0], inplace=True)

# ✅ Step 7: Verify cleaned data
print("After cleaning:\n", df.isnull().sum())
print("Remaining duplicates:", df.duplicated(subset=['transaction_id']).sum())

# 💾 Step 8: Save cleaned file
df.to_csv("cleaned_screen_time.csv", index=False)

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid")

print("Libraries imported successfully!")

# CELL 6: Histogram

plt.figure(figsize=(9, 5))

sns.histplot(
    data=df,
    x="daily_screen_time_hours",
    bins=20,
    kde=True
)

plt.title("Distribution of Daily Screen Time")
plt.xlabel("Daily Screen Time (Hours)")
plt.ylabel("Number of Users")
plt.tight_layout()
plt.show()

# CELL 7: Count plot

plt.figure(figsize=(7, 5))

sns.countplot(
    data=df,
    x="addicted_label"
)

plt.title("Distribution of Addiction Labels")
plt.xlabel("Addicted Label (0 = No, 1 = Yes)")
plt.ylabel("Number of Users")
plt.tight_layout()
plt.show()

# CELL 8: Bar chart

gender_screen = (
    df.groupby("gender", dropna=False)
      ["daily_screen_time_hours"]
      .mean()
      .sort_values(ascending=False)
      .reset_index()
)

plt.figure(figsize=(8, 5))

sns.barplot(
    data=gender_screen,
    x="gender",
    y="daily_screen_time_hours"
)

plt.title("Average Daily Screen Time by Gender")
plt.xlabel("Gender")
plt.ylabel("Average Screen Time (Hours)")
plt.tight_layout()
plt.show()

# CELL 9: Scatter plot

plt.figure(figsize=(9, 6))

sns.scatterplot(
    data=df,
    x="daily_screen_time_hours",
    y="sleep_hours",
    hue="addicted_label",
    alpha=0.7
)

plt.title("Daily Screen Time vs Sleep Hours")
plt.xlabel("Daily Screen Time (Hours)")
plt.ylabel("Sleep Hours")
plt.tight_layout()
plt.show()

# CELL 10: Grouped count plot

plt.figure(figsize=(9, 5))

sns.countplot(
    data=df,
    x="stress_level",
    hue="addicted_label"
)

plt.title("Stress Level by Addiction Label")
plt.xlabel("Stress Level")
plt.ylabel("Number of Users")
plt.legend(title="Addicted Label")
plt.tight_layout()
plt.show()

# CELL 11: Correlation heatmap

numeric_df = df.select_dtypes(include="number")
correlation = numeric_df.corr()

plt.figure(figsize=(12, 8))

sns.heatmap(
    correlation,
    annot=True,
    cmap="coolwarm",
    fmt=".2f",
    linewidths=0.5
)

plt.title("Correlation Heatmap of Numeric Variables")
plt.tight_layout()
plt.show()

# CELL 12: Key performance indicators (KPIs)

total_users = len(df)
average_screen_time = df["daily_screen_time_hours"].mean()
average_sleep = df["sleep_hours"].mean()
average_social_media = df["social_media_hours"].mean()
average_study = df["work_study_hours"].mean()

label_rate = df["addicted_label"].mean() * 100

print("========== DATA ANALYSIS SUMMARY ==========")
print(f"Total records: {total_users}")
print(f"Average daily screen time: {average_screen_time:.2f} hours")
print(f"Average sleep duration: {average_sleep:.2f} hours")
print(f"Average social media time: {average_social_media:.2f} hours")
print(f"Average work/study time: {average_study:.2f} hours")
print(f"Percentage labelled 1: {label_rate:.2f}%")

# CELL 13: Export cleaned dataset

output_file = "cleaned_screen_time_data.csv"

df.to_csv(output_file, index=False)

print("Cleaned file saved:", output_file)

files.download(output_file)

plt.savefig("screen_time_distribution.png",
            dpi=300, bbox_inches="tight")
plt.show()

